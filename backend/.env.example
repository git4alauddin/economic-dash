APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Exact origins, JSON list, no trailing slashes. Never use a wildcard.
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Production: exactly one public HTTPS frontend origin; never include localhost.
# Proxy headers are ignored by run.py until explicit trusted peer IPs/CIDRs are
# configured. M7 must verify the actual hosting proxy and HTTPS before enabling.
# No wildcard trust. Use the same safe flags if deploying Uvicorn another way.
TRUSTED_PROXY_IPS=[]
# run.py disables raw access logs to avoid recording credentials in query URLs.
# Server-only; inject 32 cryptographically random bytes encoded as 64 hex characters.
# No signing key is supplied in Git. Production refuses startup without one.
# AUTH_JWT_SIGNING_KEY=
AUTH_JWT_ISSUER=economic-dash-api
AUTH_JWT_AUDIENCE=economic-dash-web
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_CLOCK_SKEW_SECONDS=5
# Process-local sliding windows: all login POSTs count, even malformed/successful.
# Single API process/worker; budgets reset on restart. No username lockouts.
AUTH_LOGIN_CLIENT_ATTEMPTS=10
AUTH_LOGIN_GLOBAL_ATTEMPTS=60
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_MAX_CLIENTS=1024
# Private SQLite, one API instance/worker. Bootstrap: python -m app.database
# Local default: backend/.runtime/database/dashboard.sqlite3 (ignored by Git).
# Production: mount a persistent Render disk at /var/data; startup fails without it.
# DATABASE_DIRECTORY=/var/data/economic-dash
# Relative overrides resolve from backend/. Keep this outside frontend assets.
# Linux: service-user-only directory/files; Windows inherits local directory ACLs.
# Startup/bootstrap applies ordered, checksummed SQL migrations (schema version 2).
DATABASE_BUSY_TIMEOUT=5
# Process-local capacity, fail-fast overload; cumulative SQLite read budget in seconds.
DATABASE_MAX_CONNECTIONS=8
DATABASE_READ_TIMEOUT=2
# Server-side acquisition limits; blocked feeds remain disabled.
COLLECTOR_USER_AGENT=EconomicDashboard/0.1 source-collector
COLLECTOR_CONNECT_TIMEOUT=5
COLLECTOR_READ_TIMEOUT=10
COLLECTOR_ATTEMPT_TIMEOUT=15
COLLECTOR_TOTAL_TIMEOUT=45
COLLECTOR_MAX_ATTEMPTS=3
COLLECTOR_MIN_INTERVAL=1
COLLECTOR_BACKOFF_BASE=0.5
COLLECTOR_BACKOFF_CAP=5
COLLECTOR_MAX_CONNECTIONS=4
COLLECTOR_MAX_BYTES=2000000
# One scheduler per backend host. Local locks default to backend/.runtime/.
# Production: set COLLECTOR_SCHEDULER_STATE_DIRECTORY=/var/data/economic-dash
# Use the SAME directory for the service and manual refresh command.
# Accepted observations/validators reload from private SQLite after restart.
# Scheduler state-directory files are locks; DATABASE_DIRECTORY holds durable data.
COLLECTOR_SCHEDULER_ENABLED=true
COLLECTOR_SCHEDULER_STARTUP_DELAY=1
COLLECTOR_SCHEDULER_TICK_SECONDS=30
COLLECTOR_SCHEDULER_RUN_TIMEOUT=300
COLLECTOR_SCHEDULER_SHUTDOWN_TIMEOUT=10
COLLECTOR_SCHEDULER_DISCOVERY_LIMIT=2
