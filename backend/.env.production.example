# Reference only: inject into the Render API environment; do not copy into Git.
# Replace reserved .invalid URLs with the ACTUAL assigned frontend origin.
APP_ENV=production
PYTHON_VERSION=3.13.7
CORS_ALLOWED_ORIGINS=["https://frontend.example.invalid"]
# Backend secret, supplied privately in Render: 32 random bytes as 64 hex chars.
# Generate once in a private terminal; never use Render's base64 generateValue.
# Never copy the local demo/evaluator password or existing local signing key.
AUTH_JWT_SIGNING_KEY=
AUTH_JWT_ISSUER=economic-dash-api
AUTH_JWT_AUDIENCE=economic-dash-web
AUTH_ACCESS_TOKEN_MINUTES=15
TRUSTED_PROXY_IPS=[]
DATABASE_DIRECTORY=/var/data/economic-dash
COLLECTOR_SCHEDULER_STATE_DIRECTORY=/var/data/economic-dash
COLLECTOR_SCHEDULER_ENABLED=true
PYTHONUNBUFFERED=1
# Render supplies PORT. Exactly one worker; launcher ignores WEB_CONCURRENCY.
# Defaults for bounded collector/auth/database limits: see .env.example.
# Preflight: python -m app.production --check (no DB access or key output).
# Startup: python -m app.production; migrations run in lifespan, never in build.
# Provision evaluator in the RUNNING service shell with hidden password prompt:
# python -m app.auth.provision --username evaluator
# Roll back code to a verified commit/deploy; disk/schema do not roll back.
# Before schema changes, take a SQLite-consistent backup and verify restoration.
