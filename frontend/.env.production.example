# Reference only: public Render STATIC SITE build settings, no backend secrets.
# Use the API's ACTUAL assigned HTTPS origin, without /api/v1 or trailing slash.
VITE_API_BASE_URL=https://api.example.invalid
NODE_VERSION=24.19.0
SKIP_INSTALL_DEPS=true
# The reserved .invalid placeholder is deliberately rejected by build:render.
# Blueprint installs pinned npm/dependencies before running npm run build:render.
# Rebuild frontend after API URL changes; update backend's exact CORS separately.
