{
  "name": "economic-dash-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:primitives": "node scripts/verify-layout.mjs --mode primitives",
    "verify:panels": "node scripts/verify-layout.mjs --mode panels",
    "verify:ticker": "node scripts/verify-layout.mjs --mode ticker",
    "verify:states": "node scripts/verify-layout.mjs --mode states",
    "verify:audit": "node scripts/verify-layout.mjs --mode audit",
    "verify:performance": "node scripts/verify-layout.mjs --mode performance",
    "benchmark:ui": "node scripts/benchmark-ui.mjs",
    "verify:handoff": "node scripts/verify-handoff.mjs",
    "verify:requirements": "node scripts/verify-requirements.mjs",
    "verify:sources": "node scripts/verify-requirements.mjs --online",
    "test:ui": "node --test scripts/test-ui.mjs",
    "test:auth": "node --test scripts/test-auth.mjs",
    "test:boundaries": "node --test scripts/test-boundaries.mjs",
    "test:inventory": "node --test scripts/test-integration-inventory.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
